# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: dev/production server port. Defaults to 5175 if unset — do not reuse
# :3000, it's already claimed by the Gemini Ink OS Vite server and the Gitea
# connector URL in the sibling Project-Companion----visual-computer repo.
PORT=5175

# WERKSTATT_SYNC (optional): bridges this project's Timeline into a
# self-hosted "Project Companion OS" instance (werkstatt_sdk's RoadmapEngine).
# When ArtisPlan is embedded as the "Werkstatt" app's iframe inside Project
# Companion OS, the OS auto-passes its API token via the `auth_token` URL
# query string — VITE_WERKSTATT_TOKEN is only needed for standalone/dev use
# outside that iframe. Leave VITE_WERKSTATT_API_URL unset to disable the
# bridge entirely; ArtisPlan works standalone either way.
VITE_WERKSTATT_API_URL="http://127.0.0.1:9999/api/werkstatt"
VITE_WERKSTATT_TOKEN=""
VITE_WERKSTATT_DOMAIN_TAG="02_KERAMIK"
