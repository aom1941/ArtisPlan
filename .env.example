# OLLAMA_URL / OLLAMA_MODEL: self-hosted AI generation for the Moodboard
# Generator, AI Timeline Generator and Annotation Critique — replaces the
# original Google AI Studio Gemini-API boilerplate. Points at the same
# Ollama instance the rest of the stack uses (see the sibling
# Project-Companion----visual-computer repo's
# project-companion-os/backend/connectors.json, which documents qwen2.5vl:7b
# as the deployed default model). No API key needed; if Ollama is
# unreachable, each endpoint falls back to curated static defaults — never a
# hard dependency.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:7b"

# VITE_NEXTCLOUD_*: self-hosted project sync, backup & export — replaces the
# original Google Drive/Docs/Sheets integration. Use a dedicated Nextcloud
# App Password (Settings → Security → App passwords), not the account
# password, so it can be revoked independently. Leave unset to disable sync
# entirely; ArtisPlan keeps working locally (localStorage) either way. Same
# variable names as the sibling repo's lib/webdav.ts, so one Nextcloud
# instance/App Password serves both frontends.
VITE_NEXTCLOUD_URL="https://cloud.example.tld/remote.php/dav/files/<user>"
VITE_NEXTCLOUD_USER=""
VITE_NEXTCLOUD_APP_PASSWORD=""

# PORT: dev/production server port. Defaults to 5175 if unset — do not reuse
# :3000, it's already claimed by the Gemini Ink OS Vite server and the Gitea
# connector URL in the sibling Project-Companion----visual-computer repo.
PORT=5175

# WERKSTATT_SYNC (optional): bridges this project's Timeline into a
# self-hosted "Project Companion OS" instance (werkstatt_sdk's RoadmapEngine).
# When ArtisPlan is embedded as the "Werkstatt" app's iframe inside Project
# Companion OS, the OS auto-passes its API token via the `auth_token` URL
# query string — VITE_WERKSTATT_TOKEN is only needed for standalone/dev use
# outside that iframe. Leave VITE_WERKSTATT_API_URL unset to disable the
# bridge entirely; ArtisPlan works standalone either way.
VITE_WERKSTATT_API_URL="http://127.0.0.1:9999/api/werkstatt"
VITE_WERKSTATT_TOKEN=""
VITE_WERKSTATT_DOMAIN_TAG="02_KERAMIK"

# VITE_COMPANION_API_URL (optional): Project Companion OS's own core API
# (Ideen-Pool import into the Reference Gallery, the System Vitals pill in
# the Navbar, pushing open canvas annotations as an OS sticky note — see
# src/lib/companionBridge.ts). Same OS instance and auth_token handoff as
# VITE_WERKSTATT_API_URL above — if unset, it's derived by stripping that
# var's "/werkstatt" suffix, so you normally don't need to set this
# separately. Leave both unset to disable every OS integration.
VITE_COMPANION_API_URL="http://127.0.0.1:9999/api"
