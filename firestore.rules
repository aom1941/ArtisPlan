rules_version = '2';

// ArtisPlan nutzt Firestore seit 2026-08-24 nicht mehr (Sync läuft über Nextcloud-WebDAV,
// siehe src/lib/nextcloudSync.ts). Diese Regeln sperren deshalb jeden Zugriff.
// Wirkung nur nach manuellem Deploy, siehe docs/FIREBASE-HINWEIS.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
